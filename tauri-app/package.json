{
  "name": "tauri-app",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "engine": "node scripts/run-engine.mjs",
    "dev:headless": "concurrently -n engine,vite -c yellow,cyan \"npm:engine\" \"npm:dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
