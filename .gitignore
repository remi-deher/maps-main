# --- Global ---
node_modules/
**/node_modules/
.DS_Store
Thumbs.db
desktop.ini
*.log
logs/

# --- AI assistants (local-only state) ---
.claude/settings.local.json
.claude/skills/
.claude/scheduled_tasks.lock
.claude/shell-snapshots/
.claude/todos/
.claude/projects/
.claude/memory/
.mcp.json
.cursor/
.windsurf/
.aider*
.copilot/
CLAUDE.local.md

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Environment & Identity ---
.env
.env.*
.env.local
*.plist

# --- Archives ---
*.zip
*.tar.gz
*.rar
*.7z

# --- Builds & Cache ---
dist/
build/
# ...except the Go package literally named "build" (engine/internal/build),
# which the generic build/ rule above would otherwise swallow.
!engine/internal/build/
out/
.cache/
coverage/
__pycache__/
*.pyc

# --- iOS (ios-app) ---
ios-app/*.xcodeproj/
ios-app/dist/
ios-app/build/
ios-app/Payload/
DerivedData/
*.xcuserstate

# --- Go (engine) ---
engine/bin/
engine/headless
engine/headless.exe
*.exe
*.test
*.out
go.work
go.work.sum

# go:embed driver payload for the Windows portable build (assembled in CI)
engine/internal/platform/embedded/

# go:embed web UI payload (tauri-app/dist) for the -tags webui build, assembled in CI
engine/internal/webui/embedded/
